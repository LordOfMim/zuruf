# Documentation only: Zuruf does not load .env files automatically.
# Daemon/CLI defaults (no credentials):
ZURUF_PORT=47600
# Absolute directory overrides; default: ~/.local/{share,state}/zuruf and ~/.config/zuruf.
# ZURUF_DATA_DIR=
# ZURUF_STATE_DIR=
# ZURUF_CONFIG_DIR=
# 1 selects fake adapters; never use for a real review session.
# ZURUF_FAKE_ADAPTERS=1
# Exact trusted extension origin, no wildcard:
# ZURUF_EXTENSION_ORIGIN=chrome-extension://EXTENSION_ID
# Speech example only (not daemon settings):
# ZURUF_MODEL=base
# ZURUF_LANGUAGE=de
# Browser lab/integration harness only, provided privately at runtime:
# ZURUF_ENDPOINT=          CDP websocket URL on 127.0.0.1
# ZURUF_TOKEN=             Secret; never write a real token here
# ZURUF_BASE=              Local fixture HTTP URL
# ZURUF_OUTPUT=            Absolute artifact directory
# Installer round-trip test only; suppresses real session systemctl:
# ZURUF_INSTALL_TEST=1
# Installer destinations: PREFIX, XDG_DATA_HOME, XDG_STATE_HOME, XDG_CONFIG_HOME.
# Agent credentials are returned by mcp_handoff, not configured through this file.
