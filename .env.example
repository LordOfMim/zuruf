# Documentation only: Zuruf does not load .env files automatically.
# Daemon/CLI defaults (no credentials):
ZURUF_PORT=47600
# Absolute directory overrides; default: ~/.local/{share,state}/zuruf and ~/.config/zuruf.
# ZURUF_DATA_DIR=
# ZURUF_STATE_DIR=
# ZURUF_CONFIG_DIR=
# 1 selects fake adapters; never use for a real review session.
# ZURUF_FAKE_ADAPTERS=1
# The browser shell; default: next to the zuruf binary or in ../lib/zuruf.
# ZURUF_SHELL=/absolute/path/to/zuruf-shell
# Extra switches for the shell, passed on to Chromium (containers: --no-sandbox --disable-gpu):
# ZURUF_SHELL_ARGS=
# Build only: where the Chromium runtime (CEF) is downloaded and kept; default ~/.cache/zuruf/cef.
# CEF_PATH=
# Speech example only (not daemon settings):
# ZURUF_MODEL=base
# ZURUF_LANGUAGE=de
# Page agent key test only: DevTools endpoint of a running shell.
# ZURUF_TEST_CDP=http://127.0.0.1:9333
# Installer round-trip test only; suppresses real session systemctl:
# ZURUF_INSTALL_TEST=1
# Installer destinations: PREFIX, XDG_DATA_HOME, XDG_STATE_HOME, XDG_CONFIG_HOME.
# Agent credentials are returned by mcp_handoff, not configured through this file.
# Real T3 transport; pair explicitly before first use:
# T3_URL=http://127.0.0.1:3773
# ZURUF_T3_TRANSPORT=cli
# Extra screenshot masks in the main document, appended to password/private defaults:
# ZURUF_MASK_SELECTORS=.customer-name,[data-sensitive]
# Credentials: state/agents/<task>/credential.json (0600), never set through .env.
