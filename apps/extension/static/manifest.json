{
  "manifest_version": 3,
  "name": "Zuruf",
  "version": "0.1.0",
  "permissions": ["tabs", "storage", "sidePanel", "webNavigation", "debugger"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Zuruf \u00f6ffnen"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["overlay.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' ws://127.0.0.1:* http://127.0.0.1:*; style-src 'self';"
  },
  "key": ""
}
